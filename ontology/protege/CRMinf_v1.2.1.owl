    <rdfs:range rdf:resource="I16_Meaning_Comprehension"/>
    <owl:inverseOf rdf:resource="J23_interpreted_meaning_as"/>
    <rdfs:subPropertyOf rdf:resource="J2i_was_concluded_by"/>
